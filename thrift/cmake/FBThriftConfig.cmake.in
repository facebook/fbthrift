#
# CMake package configuration file for Thrift.
#
# Link against FBThrift::thriftcpp2 to depend on Thrift. Its wangle::wangle
# dependency must be found first with find_package(wangle CONFIG).
#
# Variables defined:
#   FBTHRIFT_INCLUDE_DIR - The Thrift include directory
#   THRIFT_COMPILER      - The Thrift compiler target, as used by
#                          thrift_generate(); THRIFT_COMPILER-NOTFOUND if no
#                          compiler is installed
#
# Also provides thrift_generate() from ThriftLibrary.cmake, unless the project
# already defines a command with that name.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(FBTHRIFT_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# These dependencies ship no package config, so they are found through the Find
# modules installed next to this file. The exported Thrift targets link against
# their imported targets, so a missing one must fail here, with a clear message.
# The function keeps the CMAKE_MODULE_PATH change out of the consumer's scope;
# imported targets are directory-scoped and remain visible. Function names are
# global, hence the prefix.
function(_thrift_find_module_deps)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  foreach(dep IN ITEMS Xxhash Gflags Glog Zstd)
    # FindGlog.cmake looks up Gflags and LibUnwind, so their modules are
    # installed here too.
    find_package(${dep} MODULE)
    if (NOT ${dep}_FOUND)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
          "Could not find required dependency ${dep}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

unset(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE)
_thrift_find_module_deps()
if (DEFINED ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  return()
endif()

find_dependency(fmt CONFIG)
find_dependency(ZLIB REQUIRED)
# transport, async and thrifttype carry OpenSSL::Crypto in their link interface.
find_dependency(OpenSSL)
find_package(mvfst CONFIG)

if (NOT TARGET FBThrift::thriftcpp2)
  include("${CMAKE_CURRENT_LIST_DIR}/FBThriftTargets.cmake")
endif()

# The old name of FBThrift::thrift_annotation, kept for compatibility. Exports
# can't carry an ALIAS, so define it here.
if (NOT TARGET FBThrift::thriftannotation)
  add_library(FBThrift::thriftannotation INTERFACE IMPORTED)
  target_link_libraries(FBThrift::thriftannotation
                        INTERFACE FBThrift::thrift_annotation)
endif()

# FBTHRIFT_COMPILER is deprecated. A libraries-only install exports no compiler;
# NOTFOUND keeps a consumer's COMMAND from silently receiving an empty argument.
if (TARGET FBThrift::thrift)
  # Like ThriftLibrary.cmake, keep a value the consumer set beforehand.
  if (NOT DEFINED THRIFT_COMPILER)
    set(THRIFT_COMPILER FBThrift::thrift)
  endif()
  get_target_property(FBTHRIFT_COMPILER FBThrift::thrift LOCATION)
else()
  set(FBTHRIFT_COMPILER "FBTHRIFT_COMPILER-NOTFOUND")
  # Otherwise thrift_generate() would run whatever thrift is on PATH.
  if (NOT DEFINED THRIFT_COMPILER)
    set(THRIFT_COMPILER "THRIFT_COMPILER-NOTFOUND")
  endif()
endif()

# After THRIFT_COMPILER is set: ThriftLibrary.cmake defaults it to the in-tree
# name `thrift`. The guard keeps a project's own thrift_generate().
if (NOT COMMAND thrift_generate)
  include("${FBTHRIFT_INCLUDE_DIR}/thrift/ThriftLibrary.cmake")
endif()

# The name ThriftLibrary.cmake links into a cpp2 thrift_generate() TARGET, as in
# Thrift's own build.
if (NOT TARGET FBThrift::protocol)
  add_library(FBThrift::protocol INTERFACE IMPORTED)
  target_link_libraries(FBThrift::protocol
                        INTERFACE FBThrift::thriftprotocol)
endif()

# Components, checked with find_package(FBThrift COMPONENTS ...).
# cpp2 is always built; py is the deprecated predecessor of python.
set(FBThrift_cpp2_FOUND True)
set(FBThrift_py_FOUND @THRIFT_PY_DEPRECATED@)
set(FBThrift_python_FOUND @THRIFT_PYTHON@)

set(FBThrift_FOUND True)
check_required_components(FBThrift)

if (FBThrift_FOUND AND NOT FBThrift_FIND_QUIETLY)
    message(STATUS "Found FBThrift: ${CMAKE_CURRENT_LIST_DIR}")
endif()
