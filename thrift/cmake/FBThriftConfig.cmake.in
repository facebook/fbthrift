#
# CMake package configuration file for Thrift.
#
# Link against thriftcpp2 to depend on Thrift, or against thriftprotocol if
# Thrift is built without RPC.
#
# Variables defined:
#   THRIFT_INCLUDE_DIR   - The Thrift include directory
#   THRIFT_COMPILER      - The Thrift compiler target, as used by
#                          thrift_generate(); THRIFT_COMPILER-NOTFOUND if no
#                          compiler is installed
#
# Also provides thrift_generate() from ThriftGenerate.cmake, unless the project
# already defines a command with that name.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(THRIFT_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(FBTHRIFT_INCLUDE_DIR "${THRIFT_INCLUDE_DIR}")

# Finds the packages whose imported targets the exported Thrift targets link
# against, so a missing one must fail here, with a clear message. The function
# keeps the lookups' variables and the CMAKE_MODULE_PATH change out of the
# consumer's scope; imported targets are directory-scoped and remain visible.
# find_dependency() can't be used in it: it is a macro whose return() would
# leave the function. Function names are global, hence the prefix.
function(_thrift_find_deps)
  set(quiet)
  if (${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY)
    set(quiet QUIET)
  endif()
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  # Xxhash, Gflags, Glog and Zstd ship no package config, so they are found
  # through the Find modules installed next to this file. FindGlog.cmake looks
  # up Gflags and LibUnwind, so their modules are installed here too.
  set(module_deps Xxhash Gflags Glog)
  # folly's package config also finds Boost, whose Boost::headers async links.
  set(config_deps folly)
  set(rpc "@THRIFT_RPC@")
  if (rpc)
    # transport links Zstd and ZLIB. async links wangle, whose package config
    # doesn't find fizz. fizz's looks up Sodium through FindSodium.cmake, which
    # is installed next to this file.
    list(APPEND module_deps Zstd ZLIB)
    list(APPEND config_deps fizz wangle)
  endif()
  foreach(dep IN LISTS module_deps)
    find_package(${dep} MODULE ${quiet})
    if (NOT ${dep}_FOUND)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
          "Could not find required dependency ${dep}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(dep IN LISTS config_deps)
    find_package(${dep} CONFIG ${quiet})
    if (NOT ${dep}_FOUND)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
          "Could not find required dependency ${dep}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

unset(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE)
_thrift_find_deps()
if (DEFINED ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  return()
endif()

find_dependency(fmt CONFIG)
# transport, async and thrifttype carry OpenSSL::Crypto in their link interface.
find_dependency(OpenSSL)

if (NOT TARGET FBThrift::thriftcpp2)
  include("${CMAKE_CURRENT_LIST_DIR}/FBThriftTargets.cmake")
endif()

# FBTHRIFT_COMPILER is deprecated. A libraries-only install exports no compiler;
# NOTFOUND keeps a consumer's COMMAND from silently receiving an empty argument.
if (TARGET FBThrift::thrift)
  # Like ThriftGenerate.cmake, keep a value the consumer set beforehand.
  if (NOT DEFINED THRIFT_COMPILER)
    set(THRIFT_COMPILER FBThrift::thrift)
  endif()
  get_target_property(FBTHRIFT_COMPILER FBThrift::thrift LOCATION)
else()
  set(FBTHRIFT_COMPILER "FBTHRIFT_COMPILER-NOTFOUND")
  # Otherwise thrift_generate() would run whatever thrift is on PATH.
  if (NOT DEFINED THRIFT_COMPILER)
    set(THRIFT_COMPILER "THRIFT_COMPILER-NOTFOUND")
  endif()
endif()

# After THRIFT_COMPILER is set: ThriftGenerate.cmake defaults it to the in-tree
# name `thrift`. The guard keeps a project's own thrift_generate().
if (NOT COMMAND thrift_generate)
  include("${THRIFT_INCLUDE_DIR}/thrift/ThriftGenerate.cmake")
endif()

# The name ThriftGenerate.cmake links into a cpp2 thrift_generate() target, as in
# Thrift's own build.
if (NOT TARGET FBThrift::protocol)
  add_library(FBThrift::protocol INTERFACE IMPORTED)
  target_link_libraries(FBThrift::protocol
                        INTERFACE FBThrift::thriftprotocol)
endif()

# Components, checked with find_package(FBThrift COMPONENTS ...).
# cpp2 is always built; py is the deprecated predecessor of python.
set(FBThrift_cpp2_FOUND True)
set(FBThrift_py_FOUND @THRIFT_PY_DEPRECATED@)
set(FBThrift_python_FOUND @THRIFT_PYTHON@)

set(FBThrift_FOUND True)
check_required_components(FBThrift)

if (FBThrift_FOUND AND NOT FBThrift_FIND_QUIETLY)
    message(STATUS "Found FBThrift: ${CMAKE_CURRENT_LIST_DIR}")
endif()
