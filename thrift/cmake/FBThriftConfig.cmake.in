#
# CMake package configuration file for fbthrift
#
# Defines the target "FBThrift::thriftcpp2"
# Add this to your target_link_libraries() call to depend on thrift.
#
# Note that fbthrift depends on the wangle::wangle target.  This should
# be found by calling find_package(wangle CONFIG) before finding fbthrift.
#
# This also defines the following variables
# FBTHRIFT_COMPILER - The path to the thrift compiler
#

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Save the PACKAGE_PREFIX_DIR in a separate variable.  find_dependency() calls
# below can replace PACKAGE_PREFIX_DIR with the prefix of the dependency that
# was searched for.
set(FBTHRIFT_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")

set_and_check(FBTHRIFT_CMAKE_DIR "@PACKAGE_THRIFT_INSTALL_CMAKEDIR@")
set_and_check(FBTHRIFT_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# xxhash ships no CMake package config, so Xxhash resolves in MODULE mode via
# the FindXxhash.cmake module installed alongside this config. Prepend this
# config's own directory to CMAKE_MODULE_PATH only for that lookup, and restore
# it before propagating any failure so the consumer's scope is never polluted
# (find_dependency's REQUIRED failure path would return() before a later restore).
set(_FBTHRIFT_SAVED_CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_package(Xxhash MODULE)
set(CMAKE_MODULE_PATH "${_FBTHRIFT_SAVED_CMAKE_MODULE_PATH}")
unset(_FBTHRIFT_SAVED_CMAKE_MODULE_PATH)
if (NOT Xxhash_FOUND)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "Could not find required dependency Xxhash")
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  return()
endif()

find_dependency(fmt CONFIG)
find_dependency(ZLIB REQUIRED)
find_package(mvfst CONFIG)

if (NOT TARGET FBThrift::thriftcpp2)
  include("${FBTHRIFT_CMAKE_DIR}/FBThriftTargets.cmake")
endif()

# Prefer the FBThrift::thrift1 target, which carries the right executable
# suffix on every platform. FBTHRIFT_COMPILER is kept for consumers that
# predate it; LOCATION is readable on IMPORTED targets and resolves here at
# configure time. A libraries-only install exports no compiler, so leave a
# NOTFOUND value rather than an empty string, which would reach a consumer's
# COMMAND as a silently empty argument.
if (TARGET FBThrift::thrift1)
  get_target_property(FBTHRIFT_COMPILER FBThrift::thrift1 LOCATION)
else()
  set(FBTHRIFT_COMPILER "FBTHRIFT_COMPILER-NOTFOUND")
endif()

#
# Component definitions
# The FBThrift_XXX_FOUND variables below define package components that
# can be checked by callers using "find_package(FBThrift COMPONENTS XXX)"
# e.g., "find_package(FBThrift COMPONENTS py)"
#

# We always build the cpp2 generator and its libraries
set(FBThrift_cpp2_FOUND True)

# Set FBThrift_py_FOUND if we built the thrift/lib/py library that supports
# the output from the thrift compiler's "py" generator.
# (Note that this generator is deprecated in favor of the "python" generator.)
set(FBThrift_py_FOUND @THRIFT_PY_DEPRECATED@)

set(FBThrift_python_FOUND @thrift_python@)

set(FBThrift_FOUND True)
check_required_components(FBThrift)

if (FBThrift_FOUND AND NOT FBThrift_FIND_QUIETLY)
    message(STATUS "Found FBThrift: ${FBTHRIFT_PREFIX_DIR}")
endif()
