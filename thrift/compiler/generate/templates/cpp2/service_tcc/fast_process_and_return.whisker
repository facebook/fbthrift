{{#let export partial fast_process_and_return |interface parent_service| captures |server rpc|}}
{{#if interface.has_stream_functions?}}
// Per-service scope for the stream element encoders. Static members keep
// external linkage — so they can ride writeStreamOpen as non-type template
// arguments — while the interface-qualified class name keeps two services that
// declare a stream method of the same name from colliding.
struct {{interface.cpp_name}}FastServerInternal {
{{#each interface.functions as |function|}}
{{#if function.stream?}}
  // Serialize one '{{function.name}}' stream element (and wrap a producer
  // failure) into the wire vocabulary, reusing the classic element serializer
  // keyed by the method's StreamPResultType.
  template <typename ProtocolWriter>
  static ::apache::thrift::fast_thrift::thrift::stream::Payload
  encode_{{function.cpp_name}}_value(
      {{function.stream.elem_type.cpp_type}}&& value) noexcept {
    ::apache::thrift::StreamPayloadMetadata metadata;
    metadata.payloadMetadata().ensure().responseMetadata().ensure();
    return ::apache::thrift::fast_thrift::thrift::stream::Payload{
        .data = ::apache::thrift::detail::ap::encode_stream_payload<
            ProtocolWriter,
            ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_presult::StreamPResultType>(
            std::move(value)),
        .metadata = std::make_unique<::apache::thrift::StreamPayloadMetadata>(
            std::move(metadata))};
  }

  template <typename ProtocolWriter>
  static ::apache::thrift::fast_thrift::thrift::stream::Error
  encode_{{function.cpp_name}}_error(
      ::folly::exception_wrapper&& ew) noexcept {
    return ::apache::thrift::fast_thrift::thrift::stream::Error{
        .ex = std::move(ew)};
  }
{{#if function.stream_has_first_response?}}
  // Serialize the '{{function.name}}' non-void initial response into the
  // stream's first PAYLOAD presult (field 0), reusing the unary presult
  // serializer keyed by the method's InitialResponsePResultType.
  template <typename ProtocolWriter>
  static std::unique_ptr<folly::IOBuf>
  encode_{{function.cpp_name}}_response(
      {{function.return_type.cpp_type}}&& value) noexcept {
    typename ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_presult::InitialResponsePResultType result;
    result.template get<0>().value = &value;
    result.setIsSet(0, true);
    return ::apache::thrift::fast_thrift::thrift::serializeResponse<ProtocolWriter>(
        [&](ProtocolWriter& writer) { result.write(&writer); },
        [&](ProtocolWriter& writer) { return result.serializedSizeZC(&writer); });
  }
{{/if function.stream_has_first_response?}}
{{/if function.stream?}}
{{/each}}
};

{{/if interface.has_stream_functions?}}
{{#each interface.functions as |function|}}
{{#if (and (not function.starts_interaction?) (not function.stream?) (not function.sink?) (not function.oneway?))}}
//
// Method '{{function.name}}'
//
template <typename ProtocolReader, typename ProtocolWriter>
void {{interface.cpp_name}}AppAdapter::process_{{function.cpp_name}}_impl(
    uint32_t streamId,
    std::unique_ptr<folly::IOBuf> data,
    ::apache::thrift::fast_thrift::thrift::ThriftRequestContextPtr
        requestContext) noexcept {
  using PresultT = ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_presult;

  // Inner cascade: pre-instantiated FastHandlerCallback static templates
  // own success-frame / declared-exception / undeclared-exception writes.
  using Cb = ::apache::thrift::fast_thrift::thrift::FastHandlerCallback<{{#partial server.return_type function=function service=interface}}>;

  // Built here, before any offload, because this runs on the EventBase: the
  // callback's constructor takes a DestructorGuard on the adapter, and that
  // counter is non-atomic. The callback releases it back on the EventBase
  // too, so the whole guard lifetime stays single-threaded.
  //
  // Ownership is unique from here on. The callback moves into the executor
  // task and is never copied.
  auto callback = ::apache::thrift::fast_thrift::thrift::makeFastHandlerCallback<Cb>(
      &Cb::template {{#if function.return_type.void?}}writeDone{{#else}}writeSuccess{{/if function.return_type.void?}}<PresultT, ProtocolWriter>,
      &Cb::template writeException<PresultT, ProtocolWriter>,
      this,
      streamId,
      *getEventBase(),
      {{#if function.event_based?}}nullptr{{#else}}cpuExecutor(){{/if}},
      std::move(requestContext));

  {{#if function.event_based?}}
  // @cpp.ProcessInEbThreadUnsafe: this method runs inline on the EventBase,
  // so it never consults the CPU pool even when the server has one.
  process_{{function.cpp_name}}_run<ProtocolReader, ProtocolWriter>(
      std::move(callback), std::move(data));
  {{#else}}
  auto* executor = cpuExecutor();
  if (executor == nullptr) {
    process_{{function.cpp_name}}_run<ProtocolReader, ProtocolWriter>(
        std::move(callback), std::move(data));
    return;
  }

  auto task = [this,
               executor,
               callback = std::move(callback),
               data = std::move(data)]() mutable {
    ::apache::thrift::fast_thrift::thrift::detail::HandlerExecutorScope scope(
        executor);
    if (callback->isCancellationRequested()) {
      callback->cancelled();
      return;
    }
    callback->markHandlerStarted();
    process_{{function.cpp_name}}_run<ProtocolReader, ProtocolWriter>(
        std::move(callback), std::move(data));
  };
  // folly::Function stores callables of up to six pointers inline, so
  // staying under that keeps task type erasure allocation-free.
  static_assert(
      sizeof(task) <= 6 * sizeof(void*),
      "dispatch task outgrew folly::Function's in-situ buffer");
  try {
    executor->add(std::move(task));
  } catch (...) {
    // The move-only task retains sole callback ownership. Rejection destroys
    // it here; an executor that accepted it owns either execution or cleanup.
  }
  {{/if function.event_based?}}
}

template <typename ProtocolReader, typename ProtocolWriter>
void {{interface.cpp_name}}AppAdapter::process_{{function.cpp_name}}_run(
    ::apache::thrift::fast_thrift::thrift::FastHandlerCallbackPtr<{{#partial server.return_type function=function service=interface}}> callback,
    std::unique_ptr<folly::IOBuf> data) noexcept {
  // Local args storage. Storage form must match the handler virtual's
  // parameter type so the dispatcher passes a compatible argument:
  //   - stack_arguments (the mstch_cpp2:stack_arguments compiler option, or
  //     cpp.stack_arguments on the function — unrelated to eb dispatch):
  //       handler takes `const T&` — store complex args by value.
  //   - default:
  //       handler takes `std::unique_ptr<T>` — store complex args as
  //       unique_ptr so we can std::move() them at dispatch.
  struct ArgsState {
    {{#each function.params.fields as |param|}}
      {{#if (not param.type.resolves_to_complex_return?)}}
        {{#if param.type.enum?}}
    {{param.type.cpp_type}} uarg_{{param.cpp_name}}{static_cast<{{param.type.cpp_type}}>(0)};
        {{#else}}
    {{param.type.cpp_type}} uarg_{{param.cpp_name}}{0};
        {{/if param.type.enum?}}
      {{#else if function.stack_arguments?}}
    {{param.type.cpp_type}} uarg_{{param.cpp_name}};
      {{#else}}
    std::unique_ptr<{{param.type.cpp_type}}> uarg_{{param.cpp_name}} =
        std::make_unique<{{param.type.cpp_type}}>();
      {{/if (not param.type.resolves_to_complex_return?)}}
    {{/each}}

    ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_pargs pargs() {
      ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_pargs args;
      {{#each (array.enumerate function.params.fields) as |param_index param|}}
        {{#if (and param.type.resolves_to_complex_return? (not function.stack_arguments?))}}
      args.template get<{{param_index}}>().value = uarg_{{param.cpp_name}}.get();
        {{#else}}
      args.template get<{{param_index}}>().value = &uarg_{{param.cpp_name}};
        {{/if (and param.type.resolves_to_complex_return? (not function.stack_arguments?))}}
      {{/each}}
      return args;
    }
  } args;

  try {
    auto pargs = args.pargs();
    ::apache::thrift::fast_thrift::thrift::deserializeRequest<ProtocolReader>(
        *data, pargs);
  } catch (...) {
    // Goes through the callback rather than writing to the adapter directly:
    // the callback owns the adapter guard that has to ride along with the
    // write, and it marks itself complete so its destructor does not add a
    // second response on top of the app-error frame.
    callback->sendAppError(
        ::folly::exception_wrapper(std::current_exception()));
    return;
  }

  // Dispatch to the user-implemented FastServiceHandler<Service> method.
  // The handler may complete synchronously or asynchronously; either way the
  // callback owns any further write/close coordination.
  //
  // A synchronous throw out of the handler would otherwise hit the noexcept
  // boundary on this function and terminate the process, so it is swallowed
  // here. The callback is deliberately not touched: ownership passed to the
  // handler at the call, and reaching back for it would mean a second owner
  // and the reference count that sole ownership exists to avoid.
  //
  // The client still gets an error either way. A handler that completed and
  // then threw has already written its response; one that threw without
  // completing gets INTERNAL_ERROR synthesized by the callback's destructor.
  // Reporting errors by throwing is not the documented contract —
  // callback->exception(ew) is — so the lost exception detail is confined to
  // handler misuse.
  try {
    handler_->async_{{#if function.event_based?}}eb{{#else}}tm{{/if}}_{{function.cpp_name}}(
        std::move(callback){{#partial server.get_args_ref function=function}});
  } catch (...) {
  }
}

//
// End of Method '{{function.name}}'
//

{{/if (and (not function.starts_interaction?) (not function.stream?) (not function.sink?) (not function.oneway?))}}
{{#if function.stream?}}
//
// Stream method '{{function.name}}'
//

template <typename ProtocolReader, typename ProtocolWriter>
void {{interface.cpp_name}}AppAdapter::process_{{function.cpp_name}}_impl(
    uint32_t streamId,
    std::unique_ptr<folly::IOBuf> data,
    ::apache::thrift::fast_thrift::thrift::ThriftRequestContextPtr
        requestContext) noexcept {
  using ResultT = {{#partial server.fast_stream_return_type function=function}};
  using Cb =
      ::apache::thrift::fast_thrift::thrift::FastHandlerCallback<ResultT>;

  // ResultFn binds the protocol-specialized element encoders to the
  // handler-returned factory (building the ThriftServerStreamOpenPayload the mux
  // consumes); the response variant also serializes the initial response into
  // the first PAYLOAD. ExceptionFn covers a failure before the stream opens.
  auto callback =
      ::apache::thrift::fast_thrift::thrift::makeFastHandlerCallback<Cb>(
{{#if function.stream_has_first_response?}}
          &::apache::thrift::fast_thrift::thrift::detail::writeResponseStreamOpen<
              {{function.return_type.cpp_type}},
              {{function.stream.elem_type.cpp_type}},
              &{{interface.cpp_name}}FastServerInternal::encode_{{function.cpp_name}}_response<ProtocolWriter>,
              &{{interface.cpp_name}}FastServerInternal::encode_{{function.cpp_name}}_value<ProtocolWriter>,
              &{{interface.cpp_name}}FastServerInternal::encode_{{function.cpp_name}}_error<ProtocolWriter>>,
{{#else}}
          &::apache::thrift::fast_thrift::thrift::detail::writeStreamOpen<
              {{function.stream.elem_type.cpp_type}},
              &{{interface.cpp_name}}FastServerInternal::encode_{{function.cpp_name}}_value<ProtocolWriter>,
              &{{interface.cpp_name}}FastServerInternal::encode_{{function.cpp_name}}_error<ProtocolWriter>>,
{{/if function.stream_has_first_response?}}
          &::apache::thrift::fast_thrift::thrift::detail::writeStreamException,
          this,
          streamId,
          *getEventBase(),
          {{#if function.event_based?}}nullptr{{#else}}cpuExecutor(){{/if}},
          std::move(requestContext));

  {{#if function.event_based?}}
  // @cpp.ProcessInEbThreadUnsafe: this method runs inline on the EventBase,
  // so it never consults the CPU pool even when the server has one.
  process_{{function.cpp_name}}_run<ProtocolReader, ProtocolWriter>(
      std::move(callback), std::move(data));
  {{#else}}
  auto* executor = cpuExecutor();
  if (executor == nullptr) {
    process_{{function.cpp_name}}_run<ProtocolReader, ProtocolWriter>(
        std::move(callback), std::move(data));
    return;
  }

  auto task = [this,
               executor,
               callback = std::move(callback),
               data = std::move(data)]() mutable {
    ::apache::thrift::fast_thrift::thrift::detail::HandlerExecutorScope scope(
        executor);
    if (callback->isCancellationRequested()) {
      callback->cancelled();
      return;
    }
    callback->markHandlerStarted();
    process_{{function.cpp_name}}_run<ProtocolReader, ProtocolWriter>(
        std::move(callback), std::move(data));
  };
  // folly::Function stores callables of up to six pointers inline, so
  // staying under that keeps task type erasure allocation-free.
  static_assert(
      sizeof(task) <= 6 * sizeof(void*),
      "dispatch task outgrew folly::Function's in-situ buffer");
  try {
    executor->add(std::move(task));
  } catch (...) {
    // The move-only task retains sole callback ownership. Rejection destroys
    // it here; an executor that accepted it owns either execution or cleanup.
  }
  {{/if function.event_based?}}
}

template <typename ProtocolReader, typename ProtocolWriter>
void {{interface.cpp_name}}AppAdapter::process_{{function.cpp_name}}_run(
    ::apache::thrift::fast_thrift::thrift::FastHandlerCallbackPtr<
        {{#partial server.fast_stream_return_type function=function}}> callback,
    std::unique_ptr<folly::IOBuf> data) noexcept {
  struct ArgsState {
    {{#each function.params.fields as |param|}}
      {{#if (not param.type.resolves_to_complex_return?)}}
        {{#if param.type.enum?}}
    {{param.type.cpp_type}} uarg_{{param.cpp_name}}{static_cast<{{param.type.cpp_type}}>(0)};
        {{#else}}
    {{param.type.cpp_type}} uarg_{{param.cpp_name}}{0};
        {{/if param.type.enum?}}
      {{#else if function.stack_arguments?}}
    {{param.type.cpp_type}} uarg_{{param.cpp_name}};
      {{#else}}
    std::unique_ptr<{{param.type.cpp_type}}> uarg_{{param.cpp_name}} =
        std::make_unique<{{param.type.cpp_type}}>();
      {{/if (not param.type.resolves_to_complex_return?)}}
    {{/each}}

    ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_pargs pargs() {
      ::{{interface.cpp_qualified_namespace}}::{{interface.cpp_name}}_{{function.prefixed_name}}_pargs args;
      {{#each (array.enumerate function.params.fields) as |param_index param|}}
        {{#if (and param.type.resolves_to_complex_return? (not function.stack_arguments?))}}
      args.template get<{{param_index}}>().value = uarg_{{param.cpp_name}}.get();
        {{#else}}
      args.template get<{{param_index}}>().value = &uarg_{{param.cpp_name}};
        {{/if (and param.type.resolves_to_complex_return? (not function.stack_arguments?))}}
      {{/each}}
      return args;
    }
  } args;

  try {
    auto pargs = args.pargs();
    ::apache::thrift::fast_thrift::thrift::deserializeRequest<ProtocolReader>(
        *data, pargs);
  } catch (...) {
    // Reports the failure before the stream opens: writeStreamException turns
    // this into a TApplicationException on the request. The callback owns the
    // adapter guard that rides along with the write and marks itself complete
    // so its destructor does not synthesize a second error frame.
    callback->sendAppError(
        ::folly::exception_wrapper(std::current_exception()));
    return;
  }

  // Dispatch to the user-implemented FastServiceHandler<Service> method.
  // The handler may complete synchronously or asynchronously; either way the
  // callback owns any further write/close coordination.
  //
  // A synchronous throw out of the handler would otherwise hit the noexcept
  // boundary on this function and terminate the process, so it is swallowed
  // here. The callback is deliberately not touched: ownership passed to the
  // handler at the call, and reaching back for it would mean a second owner
  // and the reference count that sole ownership exists to avoid.
  //
  // The client still gets an error either way. A handler that completed and
  // then threw has already opened (or failed) the stream; one that threw
  // without completing gets INTERNAL_ERROR synthesized by the callback's
  // destructor, which invokes writeStreamException. Reporting errors by
  // throwing is not the documented contract — callback->exception(ew) is — so
  // the lost exception detail is confined to handler misuse.
  try {
    handler_->async_{{#if function.event_based?}}eb{{#else}}tm{{/if}}_{{function.cpp_name}}(
        std::move(callback){{#partial server.get_args_ref function=function}});
  } catch (...) {
  }
}

