    {{#each struct.fields_in_serialization_order as |field|}}
      {{#if field.lazy?}}
  const bool shouldWriteLazyField_{{field.cpp_name}} = [&] {
{{#partial custom_protocol.if_should_write field=field struct=struct}}
    return true;
{{#partial custom_protocol.if_should_write_end struct=struct}}
    return false;
  }();
      {{/if field.lazy?}}
    {{/each}}
  const bool writeIndex = [&] {
    {{#each struct.fields_in_serialization_order as |field|}}
      {{#if field.lazy?}}
    if (shouldWriteLazyField_{{field.cpp_name}}) {
      return true;
    }
      {{/if field.lazy?}}
    {{/each}}
    return false;
  }();
    {{/if (and struct.indexing? (not struct.write_lazy_field_checksum?))}}
  uint32_t xfer = 0;
  xfer += prot_->writeStructBegin("{{struct.name}}");
    {{#if struct.indexing?}}
  ::apache::thrift::detail::IndexWriter<Protocol_> indexWriter(prot_, xfer, {{#if struct.write_lazy_field_checksum?}}true{{#else}}false, writeIndex{{/if}});
    {{/if struct.indexing?}}
    {{#if struct.fields?}}
  bool previousFieldHasValue = {{#if (and struct.indexing? (not struct.write_lazy_field_checksum?))}}writeIndex{{#else}}true{{/if}};
    {{/if struct.fields?}}
    {{#each (array.enumerate struct.fields_in_serialization_order with_first=true) as |i field first?|}}
{{> module_types_custom_protocol_h/serialize_field}}
    {{/each}}
    {{#if struct.indexing?}}
  indexWriter.finalize();
    {{/if struct.indexing?}}
  xfer += prot_->writeFieldStop();
  xfer += prot_->writeStructEnd();
  return xfer;
