  {{#if (object.eq? null struct.cpp_allocator_via)}}
    __fbthrift_alloc(alloc),
  {{/if (object.eq? null struct.cpp_allocator_via)}}
  {{#each (array.enumerate struct.fields_in_layout_order with_last=true) as |i field last?|}}
    {{field.cpp_storage_name}}({{!
    }}{{#if field.cpp_ref_not_boxed?}}{{!
}}{{#partial module_types.alloc_smart_ptr_fn field=field}}({{#if (object.notnull? field.default_value)}}{{#partial fields.default_value field=field}}{{#else if field.type.cpp_use_allocator?}}alloc{{/if}}){{/if field.cpp_ref_not_boxed?}}{{!
}}{{#if (and (not field.cpp_ref?) field.cpp_use_allocator?)}}{{#if field.cpp_alloc_ctor_applies_default?}}{{#partial fields.default_value field=field}}, {{/if}}alloc{{!
}}{{#else if (and (not field.cpp_ref?) field.cpp_alloc_ctor_applies_default?)}}{{#partial fields.default_value field=field}}{{!
}}{{/if (and (not field.cpp_ref?) field.cpp_use_allocator?)}}){{#if (not last?)}},
{{/if (not last?)}}{{!
  }}{{/each}} {
{{#partial default_adapter_construct_calls struct=struct}}
}
{{#if (not struct.cpp_noncopyable)}}

{{struct.cpp_underlying_name}}::{{struct.cpp_underlying_name}}(const {{struct.cpp_underlying_name}}& other, const allocator_type& alloc) :
  {{#if (object.eq? null struct.cpp_allocator_via)}}
    __fbthrift_alloc(alloc),
