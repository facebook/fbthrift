}}{{#if field.cpp_ref_not_boxed?}}other.{{field.cpp_storage_name}} ? {{#partial module_types.alloc_smart_ptr_fn field=field}}({{#if field.type.cpp_use_allocator?}}alloc, {{/if}}*other.{{field.cpp_storage_name}}) : nullptr{{!
}}{{#else}}other.{{field.cpp_storage_name}}{{#if (and (not field.cpp_ref?) field.cpp_use_allocator?)}}, alloc{{/if}}{{/if field.cpp_ref_not_boxed?}}{{!
    }}){{#if last?}}{{#if struct.isset_fields?}},{{/if}}{{#else}},{{/if}}
