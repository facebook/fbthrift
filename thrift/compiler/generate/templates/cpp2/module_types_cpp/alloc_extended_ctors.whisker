{{#let partial default_adapter_construct_calls |struct|}}
  {{#each struct.fields as |field|}}
    {{#if (and (object.notnull? field.cpp_first_adapter) (not field.opt_cpp_ref?) (not field.intern_boxed_ref?))}}
  ::apache::thrift::adapt_detail::construct<{{field.cpp_first_adapter}}, {{field.id}}>({{#if field.cpp_ref?}}*{{/if}}{{field.cpp_storage_name}}, *this);
    {{/if (and (object.notnull? field.cpp_first_adapter) (not field.opt_cpp_ref?) (not field.intern_boxed_ref?))}}
  {{/each}}
{{/let partial}}
{{#let partial copied_adapter_construct_calls |struct|}}
  {{#each struct.fields as |field|}}
    {{#if (object.notnull? field.cpp_first_adapter)}}
  {{#if field.opt_cpp_ref?}}if ({{field.cpp_storage_name}}) {{/if}}::apache::thrift::adapt_detail::construct<{{field.cpp_first_adapter}}, {{field.id}}>({{#if field.cpp_ref?}}*{{/if}}{{field.cpp_storage_name}}, *this);
    {{/if (object.notnull? field.cpp_first_adapter)}}
  {{/each}}
{{/let partial}}
