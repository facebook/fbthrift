{{#import "common/common" as common}}
{{#import "common/types" as types}}
{{#partial common.auto_generated}}

package {{service.program.javaPackage}};

import java.util.HashMap;
import java.util.Map;
import com.facebook.thrift.metadata.ThriftEnum;

  {{#each (array.enumerate service.referenced_enums) as |enum_index enum|}}
    {{#let value_batches = (array.chunk enum.values chunk_size=200)}}
    {{#if (int.gt? (array.len value_batches) 1)}}
      {{#each (array.enumerate value_batches) as |vb_index vals|}}
class {{service.javaCapitalName}}ThriftMetadataHandlerEnums_{{enum_index}}_{{vb_index}} {
    static void addElements(Map<Integer, String> elements) {
        {{#each vals as |val|}}
        elements.put({{val.value}}, "{{val.name}}");
        {{/each}}
    }
}
      {{/each}}
    {{/if (int.gt? (array.len value_batches) 1)}}

class {{service.javaCapitalName}}ThriftMetadataHandlerEnums_{{enum_index}} {
    static void addEnums(Map<String, ThriftEnum> enums) {
        {
            Map<Integer, String> elements = new HashMap<>();
    {{#if (int.gt? (array.len value_batches) 1)}}
      {{#each (array.enumerate value_batches) as |vb_index vals|}}
            {{service.javaCapitalName}}ThriftMetadataHandlerEnums_{{enum_index}}_{{vb_index}}.addElements(elements);
      {{/each}}
    {{#else}}
      {{#each enum.values as |val|}}
            elements.put({{val.value}}, "{{val.name}}");
      {{/each}}
    {{/if (int.gt? (array.len value_batches) 1)}}
            enums.put("{{enum.java_qualified_name}}", new ThriftEnum.Builder()
                .setName("{{enum.java_qualified_name}}")
                .setElements(elements)
                .build());
        }
    }
}
  {{/each}}

class {{service.javaCapitalName}}ThriftMetadataHandlerEnums {
    static Map<String, ThriftEnum> getEnums() {
        Map<String, ThriftEnum> enums = new HashMap<>();
  {{#each (array.enumerate service.referenced_enums) as |enum_index enum|}}
        {{service.javaCapitalName}}ThriftMetadataHandlerEnums_{{enum_index}}.addEnums(enums);
  {{/each}}
        return enums;
    }
}
